# Prisma — Supabase: use Transaction pooler (6543) for app traffic only where supported.
DATABASE_URL=

# Required for prisma migrate / db push — use Dashboard → Database → "Direct connection"
# (host like db.<project-ref>.supabase.co, port 5432). Encode special chars in password (%2B, %3F, …).
DIRECT_URL=

# Plant RAG recommendation chatbot (POST /chat)
APP_AI_PLANT_RAG_CHATBOT_URL=https://plant-rag-chatbot-en.onrender.com
# Optional: legacy structured recommender for /feedback only
# APP_AI_PLANT_RECOMMENDER_LEGACY_URL=https://plant-recommendation-system.onrender.com
APP_AI_TIMEOUT_MS=120000
