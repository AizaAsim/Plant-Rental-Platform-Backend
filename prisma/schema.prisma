  reviewComment       String?  @map("review_comment") @db.Text
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  cancelledByRole    String?   @map("cancelled_by_role")
  paidAt             DateTime? @map("paid_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user            User               @relation("FreelanceJobCustomer", fields: [userId], references: [id], onDelete: Cascade)
  order           Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  address         UserAddress        @relation(fields: [deliveryAddressId], references: [id])
  acceptedBy      Gardener?          @relation("FreelanceAcceptedBy", fields: [acceptedGardenerId], references: [id], onDelete: SetNull)
  payments        Payment[]
  gardenerEarning GardenerEarning?

  @@index([status, createdAt])
  @@map("freelance_jobs")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String
  userId       String?  @map("user_id")
  route        String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, route])
  @@index([key])
  @@map("idempotency_records")
}

model ManualInterventionOrder {
  id         String   @id @default(uuid())
  orderId    String   @unique @map("order_id")
  status     ManualInterventionStatus @default(OPEN)
  priority   String?  @default("NORMAL")
  reason     String?  @db.Text
  resolutionNote String? @map("resolution_note") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("manual_intervention_orders")
}

model OrderPenalty {
  id                String   @id @default(uuid())
  orderId           String   @unique @map("order_id")
  overdueDays       Int      @default(0) @map("overdue_days")
  penaltyMultiplier  Decimal? @map("penalty_multiplier") @db.Decimal(6, 4)
  runningTotal      Decimal  @default(0) @map("running_total") @db.Decimal(12, 2)
  avgDailyRate      Decimal? @map("avg_daily_rate") @db.Decimal(12, 2)
  payStatus         OrderPenaltyPayStatus @default(PENDING) @map("pay_status")
  meta              Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_penalties")
}

enum OrderComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model OrderComplaint {
  id              String               @id @default(uuid())
  complaintNumber String               @unique @map("complaint_number")
  orderId         String               @map("order_id")
  userId          String               @map("user_id")
  subject         String
  description     String               @db.Text
  status          OrderComplaintStatus @default(OPEN)
  attachments     Json?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@map("order_complaints")
}

model FreelanceMatchConfig {
  id                         String  @id @default("singleton")
  autoMatchEnabled           Boolean @default(false) @map("auto_match_enabled")
  autoMatchScoreThreshold    Decimal @default(0.8) @map("auto_match_score_threshold") @db.Decimal(4, 3)
  gardenerAcceptWindowMinutes Int   @default(30) @map("gardener_accept_window_minutes")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("freelance_match_config")
}