// schema.prisma - Plant Rental Platform

generator client {
  provider = "prisma-client-js"
}

// Use Supabase transaction pooler (e.g. :6543) for DATABASE_URL at runtime only if needed.
// Prisma migrate/schema engine cannot use that pooler — set DIRECT_URL to the Dashboard
// “Direct connection” host (db.<project-ref>.supabase.co:5432, IPv4-compatible).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  USER
  VENDOR
  GARDENER
  ADMIN
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
  PHONE_VERIFY
}

enum MaintenanceLevel {
  LOW
  MEDIUM
  HIGH
}

enum SunlightRequirement {
  LOW
  MEDIUM
  HIGH
  INDIRECT
}

enum WaterFrequency {
  DAILY
  ALTERNATE_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum OrderType {
  RENT
  BUY
  MIXED
}

/// Contract / delivery workflow: SLOT_* and AWAITING_PAYMENT gate order payment in PaymentsService.
enum OrderStatus {
  PENDING
  CONFIRMED
  SLOT_PROPOSED
  SLOT_CONFIRMED
  AWAITING_PAYMENT
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentType {
  ORDER
  RENTAL_EXTENSION
  SERVICE_BOOKING
  DEPOSIT
  REFUND
  FREELANCE_JOB
  PENALTY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RentalStatus {
  ACTIVE
  EXTENDED
  RETURNED
  OVERDUE
}

// RentalExtensionVendorApproval: when PENDING_VENDOR, customer extension waits for vendor before dates/payment apply.
enum RentalExtensionVendorApproval {
  AUTO_APPROVED
  PENDING_VENDOR
  APPROVED
  REJECTED
}

enum ServiceType {
  ONE_TIME
  RECURRING
}

enum RecurrencePattern {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskType {
  SCHEDULED_MAINTENANCE
  ON_DEMAND
  FREELANCE_SERVICE
}

enum TaskStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceProposalStatus {
  NONE
  AWAITING_CUSTOMER
  APPROVED
  RESCHEDULE_REQUESTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskImageType {
  BEFORE
  AFTER
  ISSUE
}

enum DiagnosisSeverity {
  HEALTHY
  MILD
  MODERATE
  SEVERE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ReviewableType {
  PLANT
  NURSERY
  GARDENER
}

enum FeatureType {
  TRENDING
  SEASONAL
  EDITOR_PICK
  NEW_ARRIVAL
}

enum InteractionType {
  VIEW
  WISHLIST
  CART_ADD
  RENT
  BUY
}

enum EarningStatus {
  PENDING
  PROCESSED
  PAID
}

enum EarningType {
  FREELANCE_BOOKING
  NURSERY_TASK
  FREELANCE_MARKET_JOB
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RecipientType {
  VENDOR
  GARDENER
}

enum DisputeType {
  REFUND
  QUALITY
  DELIVERY
  SERVICE
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum ApplicableFor {
  ALL
  RENT
  BUY
  SERVICE
}

enum AccountType {
  SAVINGS
  CURRENT
}

enum NotificationType {
  ORDER
  RENTAL
  BOOKING
  TASK
  PAYMENT
  PROMOTION
  SYSTEM
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ==================== MODELS ====================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  phone         String?
  fullName      String    @map("full_name")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole
  isCorporate   Boolean   @default(false) @map("is_corporate")
  companyName   String?   @map("company_name")
  gstNumber     String?   @map("gst_number")
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  // Relations
  addresses          UserAddress[]
  nursery            Nursery?
  gardener           Gardener?
  carts              Cart[]
  orders             Order[]
  serviceBookings    ServiceBooking[]
  payments           Payment[]
  plantDiagnoses     PlantDiagnosis[]
  chatSessions       ChatSession[]
  reviews            Review[]
  wishlists          Wishlist[]
  notifications      Notification[]
  interactions       UserPlantInteraction[]
  refreshTokens      RefreshToken[]
  bankDetails        BankDetail[]
  disputesRaised     Dispute[]          @relation("DisputeRaisedBy")
  disputesResolved   Dispute[]          @relation("DisputeResolvedBy")
  disputeMessages    DisputeMessage[]
  taskImages         TaskImage[]
  settingsUpdated    PlatformSetting[]
  deviceTokens       DeviceToken[]
  customPackages     CustomPlantPackage[]
  recommendationPreference UserRecommendationPreference?
  orderComplaints            OrderComplaint[]
  registerMeta     Json?    @map("register_meta")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  idempotencyRecords   IdempotencyRecord[]
  freelanceJobsRequested FreelanceJob[]    @relation("FreelanceJobCustomer")

  @@map("users")
}

model UserRecommendationPreference {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  city        String
  lightPref   String   @map("light_pref")
  waterPref   String?  @map("water_pref")
  petFriendly Boolean  @map("pet_friendly")
  space       String
  topN        Int      @default(3) @map("top_n")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_recommendation_preferences")
}

model UserAddress {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  label        String?
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  pincode      String
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            Order[]
  serviceBookings   ServiceBooking[]
  maintenanceTasks  MaintenanceTask[]
  freelanceJobs     FreelanceJob[]

  @@map("user_addresses")
}

model OtpVerification {
  id         String     @id @default(uuid())
  identifier String
  otpCode    String     @map("otp_code")
  purpose    OtpPurpose
  isUsed     Boolean    @default(false) @map("is_used")
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @db.VarChar(500)
  deviceInfo String?  @map("device_info")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Nursery {
  id              String   @id @default(uuid())
  vendorId        String   @unique @map("vendor_id")
  name            String
  slug            String   @unique
  description     String?  @db.Text
  logoUrl         String?  @map("logo_url")
  coverImageUrl   String?  @map("cover_image_url")
  addressLine1    String   @map("address_line1")
  addressLine2    String?  @map("address_line2")
  city            String
  state           String
  pincode         String
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  serviceRadiusKm Int      @default(10) @map("service_radius_km")
  phone           String
  email           String?
  isVerified      Boolean  @default(false) @map("is_verified")
  isActive        Boolean  @default(true) @map("is_active")
  ratingAvg       Decimal  @default(0) @map("rating_avg") @db.Decimal(2, 1)
  totalReviews    Int      @default(0) @map("total_reviews")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendor         User                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  workingHours   NurseryWorkingHours[]
  images         NurseryImage[]
  serviceAreas   NurseryServiceArea[]
  plants         Plant[]
  gardeners      Gardener[]
  orders         Order[]
  maintenanceTasks MaintenanceTask[]
  vendorEarnings VendorEarning[]
  vendorPackages  VendorPackage[]

  @@map("nurseries")
  NurseryInvitation NurseryInvitation[]
}

model NurseryWorkingHours {
  id         String   @id @default(uuid())
  nurseryId  String   @map("nursery_id")
  dayOfWeek  Int      @map("day_of_week")
  openTime   String?  @map("open_time")
  closeTime  String?  @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")
  createdAt  DateTime @default(now()) @map("created_at")

  nursery Nursery @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@map("nursery_working_hours")
}

model NurseryImage {
  id           String   @id @default(uuid())
  nurseryId    String   @map("nursery_id")
  imageUrl     String   @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  nursery Nursery @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@map("nursery_images")
}

model NurseryServiceArea {
  id        String   @id @default(uuid())
  nurseryId String   @map("nursery_id")
  pincode   String
  city      String?
  createdAt DateTime @default(now()) @map("created_at")

  nursery Nursery @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@unique([nurseryId, pincode])
  @@map("nursery_service_areas")
}

model PlantCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  parent   PlantCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children PlantCategory[] @relation("CategoryHierarchy")
  plants   Plant[]

  @@map("plant_categories")
}

model Plant {
  id                  String              @id @default(uuid())
  nurseryId           String              @map("nursery_id")
  categoryId          String              @map("category_id")
  name                String
  scientificName      String?             @map("scientific_name")
  slug                String
  description         String?             @db.Text
  careInstructions    String?             @map("care_instructions") @db.Text
  sunlightRequirement SunlightRequirement? @map("sunlight_requirement")
  waterFrequency      WaterFrequency?     @map("water_frequency")
  maintenanceLevel    MaintenanceLevel    @map("maintenance_level")
  isIndoor            Boolean             @default(true) @map("is_indoor")
  isPetFriendly       Boolean             @default(false) @map("is_pet_friendly")
  heightCm            Int?                @map("height_cm")
  potIncluded         Boolean             @default(true) @map("pot_included")
  rentPriceDaily      Decimal?            @map("rent_price_daily") @db.Decimal(10, 2)
  rentPriceWeekly     Decimal?            @map("rent_price_weekly") @db.Decimal(10, 2)
  rentPriceMonthly    Decimal?            @map("rent_price_monthly") @db.Decimal(10, 2)
  buyPrice            Decimal?            @map("buy_price") @db.Decimal(10, 2)
  depositAmount       Decimal             @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  isAvailableForRent  Boolean             @default(true) @map("is_available_for_rent")
  isAvailableForSale  Boolean             @default(true) @map("is_available_for_sale")
  stockQuantity       Int                 @default(0) @map("stock_quantity")
  minRentDays         Int                 @default(7) @map("min_rent_days")
  maxRentDays         Int                 @default(365) @map("max_rent_days")
  isFeatured          Boolean             @default(false) @map("is_featured")
  isActive            Boolean             @default(true) @map("is_active")
  ratingAvg           Decimal             @default(0) @map("rating_avg") @db.Decimal(2, 1)
  totalReviews        Int                 @default(0) @map("total_reviews")
  totalRentals        Int                 @default(0) @map("total_rentals")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  nursery        Nursery                @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  category       PlantCategory          @relation(fields: [categoryId], references: [id])
  images         PlantImage[]
  tags           PlantTagMapping[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  diagnoses      PlantDiagnosis[]
  wishlists      Wishlist[]
  featuredPlants FeaturedPlant[]
  interactions   UserPlantInteraction[]
  packageItems   PlantPackageItem[]
  customPackageItems CustomPlantPackageItem[]

  @@unique([nurseryId, slug])
  @@map("plants")
}

model PlantImage {
  id           String   @id @default(uuid())
  plantId      String   @map("plant_id")
  imageUrl     String   @map("image_url")
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@map("plant_images")
}

model PlantTag {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now()) @map("created_at")
  plants    PlantTagMapping[]

  @@map("plant_tags")
}

model PlantTagMapping {
  plantId String @map("plant_id")
  tagId   String @map("tag_id")

  plant Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  tag   PlantTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([plantId, tagId])
  @@map("plant_tag_mapping")
}

model Gardener {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  nurseryId           String?   @map("nursery_id")
  bio                 String?   @db.Text
  experienceYears     Int       @default(0) @map("experience_years")
  hourlyRate          Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  isFreelancer        Boolean   @default(false) @map("is_freelancer")
  isAvailable         Boolean   @default(true) @map("is_available")
  ratingAvg           Decimal   @default(0) @map("rating_avg") @db.Decimal(2, 1)
  totalReviews        Int       @default(0) @map("total_reviews")
  totalTasksCompleted Int       @default(0) @map("total_tasks_completed")
  isVerified          Boolean   @default(false) @map("is_verified")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nursery           Nursery?                @relation(fields: [nurseryId], references: [id])
  skills            GardenerSkillMapping[]
  serviceAreas      GardenerServiceArea[]
  availability      GardenerAvailability[]
  serviceBookings   ServiceBooking[]
  maintenanceTasks  MaintenanceTask[]
  gardenerEarnings  GardenerEarning[]
  staffRole         String?   @map("staff_role")
  staffNotes        String?   @map("staff_notes") @db.Text
  deactivatedAt     DateTime? @map("deactivated_at")
  deactivateReason  String?   @map("deactivate_reason") @db.Text
  acceptedFreelanceJobs FreelanceJob[] @relation("FreelanceAcceptedBy")

  @@map("gardeners")
  NurseryInvitation NurseryInvitation[]
}

model GardenerSkill {
  id        String                 @id @default(uuid())
  name      String                 @unique
  createdAt DateTime               @default(now()) @map("created_at")
  gardeners GardenerSkillMapping[]

  @@map("gardener_skills")
}

model GardenerSkillMapping {
  gardenerId String @map("gardener_id")
  skillId    String @map("skill_id")

  gardener Gardener      @relation(fields: [gardenerId], references: [id], onDelete: Cascade)
  skill    GardenerSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([gardenerId, skillId])
  @@map("gardener_skill_mapping")
}

model GardenerServiceArea {
  id         String   @id @default(uuid())
  gardenerId String   @map("gardener_id")
  pincode    String
  city       String?
  createdAt  DateTime @default(now()) @map("created_at")

  gardener Gardener @relation(fields: [gardenerId], references: [id], onDelete: Cascade)

  @@unique([gardenerId, pincode])
  @@map("gardener_service_areas")
}

model GardenerAvailability {
  id          String   @id @default(uuid())
  gardenerId  String   @map("gardener_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   String?  @map("start_time")
  endTime     String?  @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")

  gardener Gardener @relation(fields: [gardenerId], references: [id], onDelete: Cascade)

  @@map("gardener_availability")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  packageItems CartPackageItem[]

  @@map("carts")
}

model CartItem {
  id            String    @id @default(uuid())
  cartId        String    @map("cart_id")
  plantId       String    @map("plant_id")
  quantity      Int       @default(1)
  orderType     OrderType @map("order_type")
  rentStartDate DateTime? @map("rent_start_date") @db.Date
  rentEndDate   DateTime? @map("rent_end_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  plant Plant @relation(fields: [plantId], references: [id])

  @@unique([cartId, plantId, orderType])
  @@map("cart_items")
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique @map("order_number")
  userId            String        @map("user_id")
  nurseryId         String        @map("nursery_id")
  deliveryAddressId String        @map("delivery_address_id")
  orderType         OrderType     @map("order_type")
  status            OrderStatus   @default(PENDING)
  subtotal          Decimal       @map("subtotal") @db.Decimal(10, 2)
  deliveryFee       Decimal       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  taxAmount         Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  depositAmount     Decimal       @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod     String?       @map("payment_method")
  notes             String?       @db.Text
  cancelledBy       String?       @map("cancelled_by")
  cancellationReason String?      @map("cancellation_reason") @db.Text
  cancelledAt       DateTime?     @map("cancelled_at")
  deliveredAt       DateTime?     @map("delivered_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id])
  nursery         Nursery       @relation(fields: [nurseryId], references: [id])
  deliveryAddress UserAddress   @relation(fields: [deliveryAddressId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  vendorEarnings  VendorEarning[]
  reviews         Review[]
  disputes        Dispute[]
  couponUsage               CouponUsage[]
  vendorApprovalSelections  Json?         @map("vendor_approval_selections")
  workflowMeta              Json?         @map("workflow_meta")
  manualIntervention        ManualInterventionOrder?
  orderPenalty              OrderPenalty?
  orderComplaints           OrderComplaint[]
  freelanceJobs             FreelanceJob[]

  @@map("orders")
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  plantId          String        @map("plant_id")
  quantity         Int
  orderType        OrderType     @map("order_type")
  unitPrice        Decimal       @map("unit_price") @db.Decimal(10, 2)
  depositPerUnit   Decimal       @default(0) @map("deposit_per_unit") @db.Decimal(10, 2)
  totalPrice       Decimal       @map("total_price") @db.Decimal(10, 2)
  rentStartDate    DateTime?     @map("rent_start_date") @db.Date
  rentEndDate      DateTime?     @map("rent_end_date") @db.Date
  rentalStatus     RentalStatus? @map("rental_status")
  actualReturnDate DateTime?     @map("actual_return_date") @db.Date
  extensionCount   Int           @default(0) @map("extension_count")
  deliveryProofAt   DateTime?    @map("delivery_proof_at")
  deliveryCondition String?      @map("delivery_condition") @db.Text
  deliveryProofUrls Json?        @map("delivery_proof_urls")
  deliveryLineNotes String?      @map("delivery_line_notes") @db.Text
  returnProofAt     DateTime?    @map("return_proof_at")
  returnCondition   String?       @map("return_condition") @db.Text
  returnProofUrls   Json?        @map("return_proof_urls")
  returnLineNotes   String?      @map("return_line_notes") @db.Text
  restocked         Boolean      @default(false)
  restockedAt       DateTime?    @map("restocked_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plant            Plant             @relation(fields: [plantId], references: [id])
  rentalExtensions RentalExtension[]
  maintenanceTasks MaintenanceTask[]

  @@map("order_items")
}

model RentalExtension {
  id                    String                        @id @default(uuid())
  orderItemId           String                        @map("order_item_id")
  originalEndDate       DateTime                      @map("original_end_date") @db.Date
  newEndDate            DateTime                      @map("new_end_date") @db.Date
  extensionPrice        Decimal                       @map("extension_price") @db.Decimal(10, 2)
  paymentStatus         PaymentStatus                 @default(PENDING) @map("payment_status")
  vendorApprovalStatus  RentalExtensionVendorApproval @default(AUTO_APPROVED) @map("vendor_approval_status")
  vendorRejectionReason String?                       @map("vendor_rejection_reason") @db.Text
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("rental_extensions")
}

model Payment {
  id                   String            @id @default(uuid())
  orderId              String?           @map("order_id")
